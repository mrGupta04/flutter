# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins. Use * for local/dev.
# On Render production, set e.g. CORS_ORIGIN=https://your-web-app.com
# (native Flutter apps do not need CORS; * is allowed but logs a warning)
CORS_ORIGIN=*

# Registration — email OTP bypass for dummy/local testing (default: skipped).
# Set to false before production to require real email verification.
# SKIP_VERIFICATION=false

# Public URL for uploaded files (required on Render/production)
# PUBLIC_BASE_URL=https://your-service.onrender.com

# MongoDB Atlas — required
# 1. Create free cluster at https://cloud.mongodb.com
# 2. Database Access → create user
# 3. Network Access → add your IP (or 0.0.0.0/0 for dev)
# 4. Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/1mg_doctors?retryWrites=true&w=majority

# If npm start fails with querySrv ECONNREFUSED, use Standard connection string from Atlas:
# MONGODB_URI_DIRECT=mongodb://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net:27017/1mg_doctors?ssl=true&directConnection=true

# Security — CHANGE ALL SECRETS IN PRODUCTION
JWT_SECRET=replace-with-random-64-char-secret-minimum-32-chars-required
ADMIN_API_KEY=optional-legacy-api-key-header

# Main admin login (POST /api/v1/admin/login)
ADMIN_EMAIL=admin@1mgdoctors.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# Optional: seed sample doctors on startup
SEED_DATABASE=false

# --- Real UIDAI OTP (via licensed KYC partner — Surepass) ---
# Direct UIDAI API requires AUA/KUA registration with UIDAI. For production apps use Surepass:
# 1. Sign up: https://surepass.io/get-api-key/
# 2. Set token below and AADHAAR_PROVIDER=surepass
AADHAAR_PROVIDER=surepass
SUREPASS_API_TOKEN=your_surepass_bearer_token
SUREPASS_API_BASE=https://sandbox.surepass.io/api/v1
# Production: SUREPASS_API_BASE=https://kyc-api.surepass.app/api/v1
# SUREPASS_GENERATE_OTP_PATH=/aadhaar-v2/generate-otp
# SUREPASS_SUBMIT_OTP_PATH=/aadhaar-v2/submit-otp

# Development fallback only (OTP is NOT from UIDAI):
# AADHAAR_PROVIDER=mock
# AADHAAR_OTP_DEV_MODE=true

# --- Doctor email verification — Gmail ---
# OTP is emailed during doctor registration.
#
# OPTION A (recommended on Render): Gmail API over HTTPS — same Gmail account, no SMTP ports.
# 1. Google Cloud Console → create project → enable Gmail API
# 2. APIs & Services → Credentials → Create OAuth client (Desktop app)
# 3. Add redirect URI: http://localhost:3333/oauth2callback
# 4. Run locally: GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... node scripts/gmailAuthSetup.js
# 5. Copy the refresh token to Render env vars below
EMAIL_PROVIDER=gmail-api
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER=your@gmail.com
APP_NAME=MedConnect Doctors
SMTP_FROM_NAME=MedConnect Doctors
# GMAIL_API_TIMEOUT_MS=15000

# OPTION B: Gmail SMTP (works on Render Starter — blocked on Render Free)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
EMAIL_PROVIDER=smtp
APP_NAME=MedConnect Doctors
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=MedConnect Doctors
# SMTP_TIMEOUT_MS=60000

# Render / production
# NODE_ENV=production

# Local development only — logs OTP instead of sending email:
# EMAIL_PROVIDER=mock

# --- Booking payments — Razorpay ---
# Default is mock (no keys needed). Bookings auto-confirm after a simulated payment.
# When ready for production:
#   RAZORPAY_PROVIDER=razorpay
#   RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
#   RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_PROVIDER=mock
# PAYMENT_HOLD_MINUTES=15

# Hours a doctor/nurse has to accept a home-visit request (booking expiry)
# HOME_VISIT_APPROVAL_HOURS=48
# Seconds the provider app rings/shows the urgent popup (default 90)
# INCOMING_BOOKING_ALERT_SECONDS=90

# Nurse home-visit mock payment window (minutes after nurse accepts)
# NURSE_PAYMENT_MINUTES=10
# How often the server expires unpaid nurse bookings (ms)
# NURSE_PAYMENT_EXPIRE_POLL_MS=15000

# --- Online consult video calls ---
# mock = in-app demo call UI (default). jitsi = embed Jitsi Meet. agora = Agora RTC (recommended).
VIDEO_PROVIDER=agora
# Minutes before slotStart when Join is enabled (default 10)
# VIDEO_JOIN_EARLY_MINUTES=10
# Minutes after slotEnd when Join stays enabled (default 5)
# VIDEO_JOIN_GRACE_MINUTES=5
# JITSI_MEET_BASE_URL=https://meet.jit.si

# --- Agora RTC (https://console.agora.io) ---
# Create a project, copy App ID and App Certificate. Enable "Testing mode" if no certificate yet.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
# AGORA_TOKEN_TTL_SECONDS=3600

# Meeting links sent in booking confirmation emails/SMS (bookingId is appended)
# PATIENT_MEETING_LINK_PREFIX=medconnect://video-consult?bookingId=
# DOCTOR_MEETING_LINK_PREFIX=medconnect-doctor://video-consult?bookingId=

# --- Mobile push (FCM) — required for lock-screen / killed-app alerts ---
# 1. Firebase Console → create a project
# 2. Add Android apps: com.onemg.care (user) and com.onemg.admin (admin)
# 3. Download google-services.json into user_app/android/app/ and admin_app/android/app/
# 4. Project settings → Service accounts → Generate new private key
# Local: save as backend/firebase-service-account.json
# Render/production: paste the JSON into FIREBASE_SERVICE_ACCOUNT_JSON (or BASE64)
PUSH_PROVIDER=fcm
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Legacy (deprecated): FIREBASE_SERVER_KEY=AAAA...

# --- Home-visit live tracking (Socket.IO + Google Directions) ---
# Same key as Android MAPS_API_KEY, with Directions API enabled.
# If unset, ETA falls back to straight-line distance at ~25 km/h.
# GOOGLE_MAPS_API_KEY=your_google_maps_server_key
# TRACKING_PERSIST_MS=15000
# TRACKING_ROUTE_TTL_MS=45000
# TRACKING_ROUTE_RECOMPUTE_METERS=250
# TRACKING_MIN_INTERVAL_MS=2000
# TRACKING_OFFLINE_GRACE_MS=20000
# TRACKING_FALLBACK_KMH=25

# --- Ambulance dispatch & live tracking ---
# AMBULANCE_DISPATCH_BATCH_SIZE=2
# AMBULANCE_DISPATCH_OFFER_TIMEOUT_MS=25000
# AMBULANCE_DISPATCH_MAX_ROUNDS=5
# AMBULANCE_DISPATCH_EXPAND_RADIUS_KM=5
# AMBULANCE_DISPATCH_INITIAL_RADIUS_KM=15
# AMBULANCE_DISPATCH_POLL_MS=5000
# AMBULANCE_SEARCH_EXPIRE_MS=600000
# AMBULANCE_LOCATION_MIN_INTERVAL_MS=4000
# AMBULANCE_LOCATION_MIN_DISTANCE_M=20
# AMBULANCE_LOCATION_RETENTION_HOURS=48
# AMBULANCE_LOCATION_STALE_MS=30000
# AMBULANCE_ALERT_THROTTLE_MS=8000
# AMBULANCE_FALLBACK_KMH=30
